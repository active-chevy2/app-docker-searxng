# ==========================================
# SearXNG Environment Variables Configuration
# ==========================================

# The public or external URL where your SearXNG instance will be accessed.
# Used by SearXNG to construct internal redirects and absolute links.
# For local development: http://localhost:8080
# For production (Coolify / Reverse Proxy): https://search.yourdomain.com
SERVICE_URL_SEARXNG_8080=https://search.yourdomain.com

# A random secret key used for session encryption and CSRF tokens.
# Generate a strong key with: openssl rand -hex 32
SERVICE_PASSWORD_SEARXNGSECRET=4f8b91c7a39d2e1f6087b5a4c9e102f8374d6e9a1b5c2d3e4f5a6b7c8d9e0f1a

# Display name for your instance, shown in the web interface and footer.
# Defaults to "coolify" if not set.
INSTANCE_NAME=MyPrivateSearch

# Network address SearXNG binds to inside the container.
# Default: 0.0.0.0
SEARXNG_BIND_ADDRESS=0.0.0.0
