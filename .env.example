# ==========================================
# SearXNG Environment Variables Configuration
# ==========================================

# Fully qualified public URL for your instance (e.g. https://search.example.com)
BASE_URL=https://search.yourdomain.com
SEARXNG_URL=https://search.yourdomain.com

# 32-byte hexadecimal secret key used for session encryption and tokens.
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=4f8b91c7a39d2e1f6087b5a4c9e102f8374d6e9a1b5c2d3e4f5a6b7c8d9e0f1a

# Display name shown in web navigation and footer
INSTANCE_NAME=MyPrivateSearch

# Internal container bind interface
SEARXNG_BIND_ADDRESS=0.0.0.0

# -------------------------------------------------------------------
# Backward compatibility variables for Coolify / legacy environments
# -------------------------------------------------------------------
SERVICE_URL_SEARXNG_8080=https://search.yourdomain.com
SERVICE_PASSWORD_SEARXNGSECRET=4f8b91c7a39d2e1f6087b5a4c9e102f8374d6e9a1b5c2d3e4f5a6b7c8d9e0f1a
